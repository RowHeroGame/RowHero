<Window x:Class="GameLauncher.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" Height="420" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="What's new in v-.-.-"
                   FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" Foreground="#dddddd" FontSize="13"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="90" Height="34" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Update Now" Width="110" Height="34" FontWeight="Bold" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
