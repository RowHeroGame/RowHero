<Window x:Class="GameLauncher.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="428"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="6,6,14,14" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- hard offset shadow on its own layer -->
        <Border Background="{StaticResource RiverDeepBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="8" Direction="315" Color="#1A1405" Opacity="0.9"/>
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource RiverDeepBrush}"
                BorderBrush="{StaticResource RiverBrush}" BorderThickness="3" Padding="24">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{StaticResource FoamBrush}" Margin="0,0,0,10"/>

                <TextBlock x:Name="MessageText" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{StaticResource MistBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,8,8">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            MinWidth="112" Height="40" Margin="0,0,16,0" Click="Cancel_Click"/>
                    <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource PrimaryButton}"
                            MinWidth="128" Height="40" FontSize="14" Click="Confirm_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
