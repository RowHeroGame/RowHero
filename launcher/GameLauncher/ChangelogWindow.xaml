<Window x:Class="GameLauncher.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Width="440" Height="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}">
    <Grid Margin="6,6,14,14" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border Background="{StaticResource RiverDeepBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="8" Direction="315" Color="#1A1405" Opacity="0.9"/>
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource RiverDeepBrush}"
                BorderBrush="{StaticResource RiverBrush}" BorderThickness="3" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: yellow badge + title -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <Border Background="{StaticResource OarBrush}" HorizontalAlignment="Left"
                            Padding="9,4" Margin="0,0,0,12">
                        <TextBlock x:Name="BadgeText" Text="UPDATE AVAILABLE" FontSize="11" FontWeight="Bold"
                                   FontFamily="{StaticResource PixelFont}"
                                   Foreground="{StaticResource OarInkBrush}"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="What's new" FontSize="24" FontWeight="Bold"
                               TextWrapping="Wrap" Foreground="{StaticResource FoamBrush}"/>
                </StackPanel>

                <!-- Notes card -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14,10,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource PixelScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="NotesPanel" Margin="0,0,12,0"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,20,8,8">
                    <Button Content="Not now" Style="{StaticResource SecondaryButton}"
                            MinWidth="128" Height="42" Margin="0,0,16,0" Click="Cancel_Click"/>
                    <Button Content="Update now" Style="{StaticResource PrimaryButton}"
                            MinWidth="168" Height="42" FontSize="14" Click="Confirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
