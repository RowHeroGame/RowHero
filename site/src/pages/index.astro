---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { existsSync } from "node:fs";
import { url, eventUrl, DOWNLOAD_URL } from "../lib/site";

// The gameplay clip goes in only when public/gameplay.mp4 exists (adding it triggers a rebuild), so the page
// never asks for a video that isn't there.
const hasClip = existsSync("public/gameplay.mp4");

const site = new URL(url(""), Astro.site).href; // https://rowhero.uk/
// The season, read left to right like a course; each venue opens its wiki page.
const season = [
  { id: "head-of-the-charles", name: "Head of the Charles", img: "venue-charles.png", fmt: "Head race" },
  { id: "head-of-the-river", name: "Head of the River", img: "venue-river.png", fmt: "Head race" },
  { id: "nat-schools", name: "National Schools", img: "venue-nat.png", fmt: "Side by side" },
  { id: "henley", name: "Henley", img: "venue-henley.png", fmt: "Side by side" },
];
---

<Base title="Row Hero" description="Row Hero: a free rowing rhythm game for Windows. Play in time with the music to haul your crew to victory.">
<Fragment slot="head">
<link rel="canonical" href={site}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Row Hero">
<meta property="og:title" content="Row Hero: free rowing rhythm game for Windows">
<meta property="og:description" content="Play in time with the music to haul your crew to victory.">
<meta property="og:url" content={site}>
<meta property="og:image" content={`${site}img/og-image.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The Row Hero logo over two crews racing at Henley">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" as="image" href={url("background.png")} fetchpriority="high">
</Fragment>
<style is:global>
/* Order follows a visitor's questions: what is it → what can I do → where do I race → how do I get it */

/* 1 Hero: the boathouse fills the window, the logo floats in the sky */
.hero { position: relative; min-height: clamp(560px, 100vh, 940px); min-height: clamp(560px, 100svh, 940px); overflow: hidden; background: var(--sky) url("/background.png") center bottom / cover no-repeat; image-rendering: pixelated; border-bottom: 6px solid var(--river); }
.hero::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(20,42,68,0) 45%, rgba(20,42,68,.55) 100%); pointer-events: none; }
.hero-inner { position: relative; z-index: 2; display: grid; justify-items: center; gap: 24px; text-align: center; padding-top: clamp(32px, 9vh, 96px); }
.logo { width: min(560px, 88%); height: auto; image-rendering: pixelated; animation: bob 3.2s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) { .logo { animation: none; } }
@keyframes bob { 0%,100% { transform: translateY(0) rotate(-.6deg); } 50% { transform: translateY(-6px) rotate(.6deg); } }
.title { margin: 0; width: 100%; display: flex; justify-content: center; line-height: 0; }
.tagline { margin: 0; font-family: var(--pixel); font-size: clamp(0.9375rem, 0.5rem + 1.3vw, 1.25rem); letter-spacing: .04em; background: var(--river-deep); color: var(--foam); padding: 8px 16px; box-shadow: 4px 4px 0 var(--oar); text-wrap: balance; }
.platform-note { display: grid; justify-items: center; margin: 0; max-width: 36ch; padding: 8px 16px; background: var(--river-deep); color: var(--foam); font-size: 1rem; line-height: 1.5; text-wrap: balance; }
.platform-note[hidden] { display: none; }
.send-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0; font: inherit; font-weight: 700; color: var(--oar); background: none; border: 0; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
.send-link:focus-visible { outline: 3px solid var(--foam); outline-offset: 2px; }

/* Sections: one centred column, each opening with its heading */
section { padding-block: 56px; border-bottom: 1px solid var(--line); text-align: center; }
section:last-of-type { border-bottom: 0; }
h2 { font-family: var(--display); font-weight: 700; font-size: clamp(1.75rem, 1rem + 2.2vw, 2.5rem); line-height: 1.15; margin: 0 auto 16px; text-wrap: balance; }
h2 .line { display: inline-block; }  /* break between sentences before breaking inside one */
h3 { font-family: var(--pixel); font-size: 1.0625rem; font-weight: 700; letter-spacing: .02em; line-height: 1.25; margin: 0 0 8px; }
p { margin: 0 auto 16px; max-width: 65ch; }

/* 2 Gameplay: add gameplay.mp4 to public/ and, once the site rebuilds, it plays; until then the Henley scene shows,
   with both crews rowing as you scroll (the still image underneath is the no-JavaScript fallback) */
.clip { position: relative; aspect-ratio: 16 / 9; margin-top: 32px; background: var(--river) url("/img/henley-scene.png") center / cover no-repeat; image-rendering: pixelated; border: 3px solid var(--river); overflow: hidden; }
.clip canvas, .clip video { position: absolute; inset: 0; width: 100%; height: 100%; }
.clip canvas { image-rendering: pixelated; }
.clip video { display: none; object-fit: cover; }
.clip.has-video video { display: block; }
.clip.has-video canvas { display: none; }
.clip-toggle { display: none; position: absolute; right: 12px; bottom: 12px; min-width: 44px; min-height: 44px; padding: 0 16px; font-family: var(--pixel); font-size: 0.875rem; color: var(--foam); background: var(--river-deep); border: 2px solid var(--foam); cursor: pointer; }
.clip-toggle:focus-visible { outline: 3px solid var(--oar); outline-offset: 2px; }
.clip.has-video .clip-toggle { display: inline-flex; align-items: center; }

/* 3 Features: one line each across the full width, wrapping only when the screen is narrow */
.features { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 12px; text-wrap: pretty; }
.features b { color: var(--oar); }

/* 4 The season: one row, read left to right like a course; each venue opens its wiki page */
.season { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 16px; counter-reset: v; text-align: left; }
.season li { counter-increment: v; min-width: 0; }
.season .mark { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
.season .mark::before { content: counter(v, decimal-leading-zero); flex: none; display: grid; place-items: center; width: 40px; height: 40px; font-family: var(--pixel); font-weight: 700; background: var(--river); color: var(--oar); }
.season li:not(:last-child) .mark::after { content: ""; flex: 1; height: 3px; margin-right: -16px; background: repeating-linear-gradient(90deg, var(--river) 0 8px, transparent 8px 14px); }
.season li:last-child .mark::before { background: var(--oar); color: var(--oar-ink); }
.season .final { font-family: var(--pixel); font-size: 0.75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--oar); }
.season a { display: block; color: inherit; text-decoration: none; }
.season img { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; transition: transform 100ms ease-out, box-shadow 100ms ease-out; }
.season strong { display: block; margin-top: 8px; font-size: 1.125rem; line-height: 1.25; text-underline-offset: 4px; }
.season strong::after { content: " \203A"; color: var(--oar); }
.season span.fmt { font-family: var(--pixel); font-size: 0.75rem; color: var(--mist); }
@media (hover: hover) {
  .season a:hover img { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--oar); }
  .season a:hover strong { text-decoration: underline; }
}
@media (prefers-reduced-motion: reduce) { .season img { transition: none; } }
.season a:focus-visible { outline: 3px solid var(--oar); outline-offset: 4px; }
.season-more { margin: 32px auto 0; text-align: center; }
.season-more a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--pixel); font-size: 0.9375rem; color: var(--oar); text-underline-offset: 4px; }
.season-more a:focus-visible { outline: 3px solid var(--oar); outline-offset: 2px; }
@media (max-width: 47.99em) {
  .season { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .season li:nth-child(2) .mark::after { display: none; }
}

/* 5 Download: the button up front, then install steps beside the requirements */
.cta { display: grid; justify-items: center; gap: 16px; margin-top: 24px; }
.cta-meta { margin: 0; font-size: 1rem; color: var(--mist); }
.cta .platform-note { padding: 0; background: none; }
.get { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 32px 48px; margin-top: 48px; align-items: start; text-align: left; }
.install { padding-top: 24px; }
.install h3 { margin-bottom: 16px; }
.steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; counter-reset: s; }
.steps li { counter-increment: s; display: grid; grid-template-columns: 44px 1fr; gap: 16px; align-items: center; font-weight: 700; }
.steps li::before { content: counter(s); font-family: var(--pixel); font-weight: 700; font-size: 1.125rem; width: 44px; height: 44px; display: grid; place-items: center; background: var(--river); color: var(--oar); }
.note { margin: 24px 0 0; padding: 16px; background: var(--river); font-size: 1rem; color: var(--mist); }
.note b { color: var(--foam); }
.reqs { padding: 24px 24px 8px; background: var(--river); }
.reqs h3 { margin-bottom: 8px; }
.reqs dl { margin: 0; }
.reqs dl div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; align-items: baseline; padding: 12px 0; border-top: 1px solid var(--line); }
.reqs dt { font-family: var(--pixel); font-size: 0.75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--mist); }
.reqs dd { margin: 0; min-width: 0; }
.reqs dd small { display: block; color: var(--mist); font-size: 1rem; }
</style>

<header class="hero" id="top">
  <div class="hero-inner wrap">
    <h1 class="title"><img class="logo" src={url("logo.png")} alt="Row Hero" width="1296" height="828"></h1>
    <p class="tagline">Row to the beat.</p>
    <a class="btn" id="dl-top" href={DOWNLOAD_URL} rel="noopener">
      <svg viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M7 1h2v8h2v-1h1v-1h1v2h-1v1h-1v1h-1v1H8v-1H7v-1H6v-1H5V9H3V7h1v1h1v1h2zM2 13h12v2H2z"/></svg>
      Download for Windows
    </a>
    <p class="platform-note" hidden aria-live="polite">Row Hero runs on Windows PCs. <button type="button" class="send-link">Send yourself the link</button></p>
  </div>
</header>

<main id="content" tabindex="-1">
  <section>
    <div class="wrap">
      <h2><span class="line">Play in time with the music.</span> <span class="line">Haul your crew to victory.</span></h2>
      <p>Row Hero is a free rowing rhythm game for Windows.</p>

      <!-- Gameplay: save the clip as public/gameplay.mp4 and it plays here (muted, looping) after the next build.
           Until then the Henley scene shows, with both crews rowing as you scroll. -->
      <div class="clip" id="clip">
        <canvas id="scene" width="384" height="216" role="img" aria-label="Two crews racing past the grandstand at Henley"></canvas>
        {hasClip && (
          <video id="gameplay" autoplay muted loop playsinline preload="metadata" width="1280" height="720" aria-label="Row Hero gameplay">
            <source src={url("gameplay.mp4")} type="video/mp4">
          </video>
          <button class="clip-toggle" id="clip-toggle" type="button">Pause</button>
        )}
      </div>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2>Features</h2>
      <ul class="features">
        <li><b>Career mode:</b> Race a full season, with all four iconic venues of schoolboy rowing.</li>
        <li><b>Free play:</b> Play any song you want at any venue, or add your own songs.</li>
        <li><b>Leaderboards:</b> Log in with Google to post your best scores and see how you stack up.</li>
        <li><b>Play offline:</b> No account needed. Your saves stay on your own computer.</li>
      </ul>
    </div>
  </section>

  <section id="season">
    <div class="wrap">
      <h2>The season</h2>
      <ol class="season">
        {season.map((v, i) => (
          <li>
            <div class="mark">{i === season.length - 1 && <span class="final">Finale</span>}</div>
            <a href={eventUrl(v.id)}><img class="px" src={url(`img/${v.img}`)} alt="" width="384" height="96"><strong>{v.name}</strong><span class="fmt">{v.fmt}</span></a>
          </li>
        ))}
      </ol>
      <p class="season-more"><a href={url("wiki/")}>Explore the wiki: every rower, venue and song</a></p>
    </div>
  </section>

  <section id="get-started">
    <div class="wrap">
      <h2>Download</h2>
      <div class="cta">
        <a class="btn" href={DOWNLOAD_URL} rel="noopener">
          <svg viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M7 1h2v8h2v-1h1v-1h1v2h-1v1h-1v1h-1v1H8v-1H7v-1H6v-1H5V9H3V7h1v1h1v1h2zM2 13h12v2H2z"/></svg>
          Download for Windows
        </a>
        <p class="cta-meta">Free, for Windows 10 and 11</p>
        <p class="platform-note" hidden aria-live="polite">Row Hero runs on Windows PCs. <button type="button" class="send-link">Send yourself the link</button></p>
      </div>

      <div class="get">
        <div class="install">
          <h3>Installing</h3>
          <ol class="steps">
            <li>Download the installer</li>
            <li>Run it</li>
            <li>Launch and row</li>
          </ol>
          <p class="note"><b>Windows warning?</b> The installer isn't signed yet, so Windows SmartScreen may say it "protected your PC". Click <b>More info</b>, then <b>Run anyway</b>.</p>
        </div>
        <div class="reqs">
          <h3>System requirements</h3>
          <dl>
            <div><dt>OS</dt><dd>Windows 10 or 11, 64&#8209;bit</dd></div>
            <div><dt>Storage</dt><dd>1.2 GB<small>2.5 GB free while installing</small></dd></div>
            <div><dt>Input</dt><dd>Keyboard</dd></div>
            <div><dt>Internet</dt><dd>To install and update<small>Play offline any time</small></dd></div>
            <div><dt>Account</dt><dd>Not needed<small>Google login for leaderboards only</small></dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer version="1.0.1" />

<script is:inline>
// Top download button: let the download start, then bring the install steps and Windows warning into view.
var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
document.getElementById("dl-top").addEventListener("click", function () {
  setTimeout(function () {
    document.getElementById("get-started").scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
  }, 150);
});

// Gameplay clip: show it once it loads; don't autoplay for people who've asked for less motion.
var clipBox = document.getElementById("clip"), video = document.getElementById("gameplay");
if (video) {
  if (reduceMotion) { video.removeAttribute("autoplay"); video.pause(); }
  video.addEventListener("loadeddata", function () { clipBox.classList.add("has-video"); if (!reduceMotion) video.play().catch(function () {}); syncToggle(); });
  var toggle = document.getElementById("clip-toggle");
  function syncToggle() { toggle.textContent = video.paused ? "Play" : "Pause"; toggle.setAttribute("aria-label", (video.paused ? "Play" : "Pause") + " gameplay video"); }
  toggle.addEventListener("click", function () { if (video.paused) video.play(); else video.pause(); });
  video.addEventListener("play", syncToggle); video.addEventListener("pause", syncToggle);
}

// Placeholder scene: the crews row with your scrolling, forwards on the way down and backwards on the way up.
// Hull frames and heads come straight from the game (64x32 frames, 12-frame stroke, heads placed by its neck table),
// drawn on the game's own 384x216 pixel grid so every position snaps to a whole game pixel.
(function () {
  var canvas = document.getElementById("scene"), ctx = canvas.getContext("2d");
  var srcs = { bg: "img/henley-bg.png", gold: "img/crew-gold.png", rival: "img/crew-rival.png" }, img = {}, waiting = 3, queued = false;
  Object.keys(srcs).forEach(function (k) {
    img[k] = new Image();
    img[k].onload = function () { if (--waiting === 0) start(); };
    img[k].src = srcs[k];
  });
  function strokeFrame(px, pxPerFrame, phase) { return ((Math.floor(px / pxPerFrame) + phase) % 12 + 12) % 12; }
  function draw() {
    queued = false;
    if (clipBox.classList.contains("has-video")) return;
    var r = canvas.getBoundingClientRect(), vh = window.innerHeight;
    if (r.bottom < 0 || r.top > vh) return;
    // 0 as the scene comes in at the bottom of the window, 1 as it leaves at the top
    var p = reduceMotion ? 0.5 : Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
    var y = reduceMotion ? 0 : window.scrollY;
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(img.bg, 0, 0);
    ctx.drawImage(img.rival, 64 * strokeFrame(y, 13, 4), 0, 64, 32, Math.round(10 + p * 270), 158, 64, 32);
    ctx.drawImage(img.gold, 64 * strokeFrame(y, 12, 0), 0, 64, 32, Math.round(-30 + p * 340), 184, 64, 32);
  }
  function queue() { if (!queued) { queued = true; requestAnimationFrame(draw); } }
  function start() {
    draw();
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue);
  }
})();

// Not on Windows (phones, Macs, Chromebooks)? Say so under the download buttons, and offer to pass the link on.
(function () {
  var ua = navigator.userAgent, uaPlat = (navigator.userAgentData && navigator.userAgentData.platform) || "";
  if (/Windows/i.test(uaPlat) || /^Win/i.test(navigator.platform || "") || /Windows NT/i.test(ua)) return;
  var url = location.href.split("#")[0];
  var canShare = !!navigator.share, canCopy = !!(navigator.clipboard && navigator.clipboard.writeText);
  document.querySelectorAll(".platform-note").forEach(function (note) {
    note.hidden = false;
    var btn = note.querySelector(".send-link");
    if (!canShare && !canCopy) { btn.remove(); return; }
    var label = canShare ? "Send yourself the link" : "Copy the link";
    btn.textContent = label;
    btn.addEventListener("click", function () {
      if (canShare) { navigator.share({ title: "Row Hero", text: "Row Hero, a free rowing rhythm game for Windows", url: url }).catch(function () {}); return; }
      navigator.clipboard.writeText(url).then(function () {
        btn.textContent = "Link copied";
        setTimeout(function () { btn.textContent = label; }, 2500);
      });
    });
  });
})();

// Show the live game version from the same manifest the launcher reads (falls back to the version in the HTML).
fetch("https://raw.githubusercontent.com/RowHeroGame/RowHero/main/manifest.json", { cache: "no-store", priority: "low" })
  .then(function (r) { return r.ok ? r.json() : null; })
  .then(function (m) { if (m && m.game && m.game.version) document.getElementById("game-version").textContent = m.game.version; })
  .catch(function () {});
</script>
</Base>
