---
// A character's article: infobox with portrait, side, effect and cost (or unlock), then everyone on the same side.
import WikiLayout from "../../../../layouts/WikiLayout.astro";
import Infobox from "../../../../components/wiki/Infobox.astro";
import CharacterCard from "../../../../components/wiki/CharacterCard.astro";
import Navbox from "../../../../components/wiki/Navbox.astro";
import CategoryBar from "../../../../components/wiki/CategoryBar.astro";
import { url, cost, linkify, plain, SIDE_LABEL, wikiData, type Character } from "../../../../lib/site";

export async function getStaticPaths() {
  const { characters } = await wikiData();
  return characters.map((character) => ({ params: { id: character.id }, props: { character } }));
}

interface Props {
  character: Character;
}
const { character } = Astro.props;
const { id, data: c } = character;
const { shopRowers, clubRowers, coaches } = await wikiData();

const isShop = c.kind === "shop";
const isCoach = c.kind === "coach";
const list = url("wiki/characters/");
const related = [...shopRowers, ...clubRowers, ...coaches].filter((r) => r.data.side === c.side && r.id !== id);
const sameSide = c.side === "both" ? "Everyone else who can row on either side." : `Everyone else who rows ${SIDE_LABEL[c.side].toLowerCase()}.`;
const description = `${c.name}: ${c.who.toLowerCase()}, ${SIDE_LABEL[c.side].toLowerCase()}. ${c.effect ? plain(c.effect) : "No perk."}`;
const category = { shop: "Shop rowers", club: "Club rowers", coach: "Coaches" }[c.kind];
---

<WikiLayout title={`${c.name} | Row Hero Wiki`} description={description}>
  <article>
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={url("wiki/")}>Wiki</a></li>
        <li><a href={list}>Characters</a></li>
      </ol>
    </nav>
    <h1 class="page-title">{c.name}</h1>

    <Infobox title={c.name}>
      <img slot="image" class="ib-portrait" src={url(`img/wiki/${c.image}`)} alt={`${c.name}'s portrait`} width="35" height="35" />
      <div><dt>Who</dt><dd>{c.who}</dd></div>
      <div><dt>Side</dt><dd>{SIDE_LABEL[c.side]}</dd></div>
      {c.effect ? <div><dt>Effect</dt><dd set:html={linkify(c.effect)} /></div> : <div><dt>Effect</dt><dd>None</dd></div>}
      {isCoach ? <div><dt>Unlock</dt><dd set:html={linkify(c.unlock ?? "")} /></div> : <div><dt>Cost</dt><dd>{cost(c.cost)}</dd></div>}
    </Infobox>

    {
      isShop ? (
        c.side === "both" ? (
          <p class="lead"><b>{c.name}</b> is a rower you can buy in the regatta shop. Rows on either side, so fits any seat.</p>
        ) : (
          <p class="lead"><b>{c.name}</b> is a {c.side}-side rower you can buy in the regatta shop.</p>
        )
      ) : isCoach ? (
        <p class="lead"><b>{c.name}</b> is {c.side === "both" ? "a coach" : `a ${c.side}-side coach`}. Coaches are unlocked by achievements and only row in Free Play. Coach effects aren't in the game yet (1.3.0).</p>
      ) : (
        <p class="lead"><b>{c.name}</b> is a club rower. Club rowers fill any empty seat for free, row either side and have no perk.</p>
      )
    }

    <h2 id="related">Related characters</h2>
    <p class="sub">{sameSide}</p>
    <ul class="gallery small">{related.map((r) => <CharacterCard character={r} small />)}</ul>

    <Navbox current={id} />
    <CategoryBar links={[{ label: "Characters", href: list }, { label: category, href: list }]} />
  </article>
</WikiLayout>
