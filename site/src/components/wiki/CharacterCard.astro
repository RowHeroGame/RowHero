---
// Gallery card: portrait, name and one line of detail, coloured by kind (see the key on the characters page);
// the whole card links to the character's page.
import { url, characterUrl, characterMeta, type Character } from "../../lib/site";

interface Props {
  character: Character;
  small?: boolean;
}
const { character: c, small = false } = Astro.props;
const size = small ? 70 : 105;
const meta = characterMeta(c);
---

<li>
  <a class={`card ${c.data.kind}`} href={characterUrl(c.id)}>
    <img src={url(`img/wiki/${c.data.image}`)} alt="" width={size} height={size} loading="lazy" />
    <span class="card-name">{c.data.name}</span>
    <span class="card-meta">{meta}</span>
  </a>
</li>
