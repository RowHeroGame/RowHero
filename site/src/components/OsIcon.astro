---
// 16x16 pixel icons for the download picker, drawn on whole pixels to match the site's pixel art.
// "phone" and "screen" are for visitors the game doesn't run on (phones and tablets; Linux and Chromebooks).
interface Props {
  os: "win" | "mac" | "phone" | "screen";
  class?: string;
}
const { os, class: className } = Astro.props;

type Rect = [x: number, y: number, w: number, h: number];
const shapes: Record<Props["os"], Rect[]> = {
  win: [[1, 1, 6, 6], [9, 1, 6, 6], [1, 9, 6, 6], [9, 9, 6, 6]],
  mac: [
    [10, 0, 2, 1], [9, 1, 2, 1], [8, 2, 2, 1],
    [3, 3, 4, 1], [9, 3, 4, 1],
    [2, 4, 12, 1], [1, 5, 11, 4], [1, 9, 12, 1], [1, 10, 13, 1],
    [2, 11, 12, 2], [3, 13, 10, 1], [4, 14, 3, 1], [9, 14, 3, 1],
  ],
  // Outlines: later rects cut holes (even-odd fill)
  phone: [[4, 0, 8, 16], [5, 2, 6, 10], [7, 13, 2, 1]],
  screen: [[1, 2, 14, 10], [2, 3, 12, 8], [7, 12, 2, 2], [4, 14, 8, 1]],
};
const d = shapes[os].map(([x, y, w, h]) => `M${x} ${y}h${w}v${h}h-${w}z`).join("");
---

<svg class={className} viewBox="0 0 16 16" aria-hidden="true" shape-rendering="crispEdges">
  <path fill="currentColor" fill-rule="evenodd" d={d} />
</svg>
