---
// Portable infobox: title band, picture, then label / value rows (pass <div><dt/><dd/></div> children).
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<aside class="infobox" aria-label={`${title} at a glance`}>
  <h2 class="ib-title">{title}</h2>
  <figure class="ib-image"><slot name="image" /></figure>
  <dl class="ib-data"><slot /></dl>
</aside>
