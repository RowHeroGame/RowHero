---
// The navbox at the foot of every article: every page in the wiki, grouped.
import { characterUrl, eventUrl, wikiData, SECTIONS } from "../../lib/site";

interface Props {
  /** id of the page this navbox is on, so it can mark itself. */
  current: string;
}
const { current } = Astro.props;
const { shopRowers, clubRowers, events } = await wikiData();

const groups = [
  { label: "Shop rowers", links: shopRowers.map((c) => ({ id: c.id, name: c.data.name, href: characterUrl(c.id) })) },
  { label: "Club rowers", links: clubRowers.map((c) => ({ id: c.id, name: c.data.name, href: characterUrl(c.id) })) },
  { label: "Events", links: events.map((e) => ({ id: e.id, name: e.data.name, href: eventUrl(e.id) })) },
  { label: "Sections", links: SECTIONS.map((s) => ({ id: s.key, name: s.name, href: s.href })) },
];
---

<nav class="navbox" aria-labelledby="navbox-title">
  <p class="navbox-title" id="navbox-title">Row Hero</p>
  {
    groups.map((g) => (
      <div class="navbox-row">
        <div class="navbox-group">{g.label}</div>
        <ul class="navbox-list">
          {g.links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.id === current ? "page" : undefined}>{l.name}</a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
